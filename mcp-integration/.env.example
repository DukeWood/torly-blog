# WordPress Configuration
WP_SITE_URL=https://torly.ai
WP_USERNAME=your_wordpress_username
WP_APP_PASSWORD=your_application_password

# WordPress Installation Path (for WP-CLI)
WP_CLI_PATH=/usr/local/bin/wp

# GoDaddy API Configuration
GODADDY_API_KEY=your_godaddy_api_key
GODADDY_API_SECRET=your_godaddy_api_secret

# Domain Configuration
PRIMARY_DOMAIN=torly.ai
BLOG_SUBDOMAIN=blog.torly.ai

# Database Configuration (for local development)
DB_HOST=localhost
DB_NAME=torly_wordpress
DB_USER=torly_user
DB_PASSWORD=secure_password

# Development/Production Mode
NODE_ENV=production

# Optional: SMTP Configuration for Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Optional: Backup Configuration
BACKUP_PATH=/var/backups/wordpress
BACKUP_RETENTION_DAYS=30